{
  "name": "@apples/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"const {cpSync}=require('fs');cpSync('src/migrations','dist/migrations',{recursive:true});cpSync('src/ai-guide.md','dist/ai-guide.md')\"",
    "start": "node dist/index.js",
    "mcp": "tsx src/mcp-stdio.ts",
    "seed": "tsx src/seed.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "@fastify/swagger": "^9.9.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
